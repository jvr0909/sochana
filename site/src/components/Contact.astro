---
import { contact } from "../content";
import BookingForm from "./BookingForm.astro";
import Aurora from "./ui/Aurora.astro";
---

<section class="contact wrap" id="contact">
  <div class="inner">
    <!-- Left: what happens after you book -->
    <div class="card">
      <Aurora
        blobs={[
          { color: "--teal-500", size: 340, x: "40%", y: "-45%", duration: 15 },
          { color: "--blue-500", size: 300, x: "-35%", y: "-35%", duration: 18, path: "b" },
          { color: "--teal-900", size: 300, x: "20%", y: "50%", duration: 13, path: "b" },
          { color: "--blue-900", size: 300, x: "60%", y: "70%", duration: 16 },
        ]}
      />
      <div class="head">
        <span class="eyebrow">{contact.eyebrow}</span>
        <h2>{contact.title}</h2>
      </div>
      <ol>
        {
          contact.next.map((n) => (
            <li>
              <span class="num">{n.num}</span>
              <div class="text">
                <strong>{n.title}</strong>
                <span>{n.body}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Right: the booking form -->
    <div class="form-wrap"><BookingForm /></div>
  </div>
</section>

<style>
  .contact { padding-bottom: clamp(64px,7vw,96px); scroll-margin-top: 24px; }
  .inner { display: flex; flex-wrap: wrap; gap: 20px; align-items: stretch; }

  .card {
    position: relative;
    flex: 1 1 340px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--ink-900);
    padding: clamp(28px,3vw,44px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }
  .head { position: relative; display: flex; flex-direction: column; gap: 18px; }
  .head .eyebrow { color: var(--ink-100); }
  h2 {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(32px,3.3vw,48px);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: var(--white);
    text-wrap: balance;
  }

  ol { position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  li { display: flex; gap: 14px; align-items: flex-start; }
  .num { font-family: var(--font-mono); font-size: 13px; color: var(--teal-400); padding-top: 2px; flex: none; }
  .text { display: flex; flex-direction: column; gap: 3px; }
  .text strong { font-size: 16px; font-weight: 600; color: var(--white); }
  .text span { font-size: 14px; line-height: 1.5; color: var(--ink-100); }

  .form-wrap { flex: 1.3 1 420px; min-width: 0; }
</style>
