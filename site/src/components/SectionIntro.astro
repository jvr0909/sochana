---
// Eyebrow, heading and lead paragraph that open the Services and How it works sections.
interface Props {
  eyebrow: string;
  title: string;
  body: string;
}

const { eyebrow, title, body } = Astro.props;
---

<div class="intro" data-reveal>
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  <p>{body}</p>
</div>

<style>
  .intro { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
  h2 {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(30px,3vw,44px);
    line-height: 1.08;
    letter-spacing: -.03em;
    color: var(--text-strong);
  }
  p { font-size: 17px; line-height: 1.6; color: var(--text-body); }
</style>
