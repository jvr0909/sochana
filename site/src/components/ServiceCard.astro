---
import { Check, Compass, FileCheck, Search, ShieldCheck } from "@lucide/astro";
import type { Service } from "../content";

type Props = Service;

const icons = { search: Search, "shield-check": ShieldCheck, "file-check": FileCheck, compass: Compass };
const { icon, eyebrow, title, body, gets } = Astro.props;
const Icon = icons[icon];
---

<article class="service">
  <div class="icon"><Icon size={20} aria-hidden="true" /></div>
  <div class="body">
    <span class="eyebrow">{eyebrow}</span>
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
  <ul>
    {
      gets.map((g) => (
        <li>
          <span class="check"><Check size={15} aria-hidden="true" /></span>
          <span>{g}</span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-l);
    padding: clamp(22px,2.2vw,32px);
  }

  .icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--ink-100);
    color: var(--ink-900);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .body { display: flex; flex-direction: column; gap: 10px; }
  .body .eyebrow { font-size: 11px; color: var(--text-accent); }
  h3 { font-family: var(--font-mono); font-weight: 500; font-size: 24px; letter-spacing: -.01em; line-height: 1.3; color: var(--text-strong); }
  p { font-size: 15px; line-height: 1.6; color: var(--text-body); text-wrap: pretty; }

  /* What you get */
  ul {
    list-style: none;
    margin: 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--text-strong); }
  .check { color: var(--teal-700); margin-top: 2px; flex: none; }
</style>
