---
import { contactEmail, footerLine } from "../content";
---

<footer class="site-footer wrap">
  <a href="/" class="logo"><img src="/logo-lockup-on-light.png" alt="Sochana" width="610" height="130" /></a>
  <div class="links">
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    <a href="/privacy">Privacy policy</a>
    <span>{footerLine}</span>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 32px;
    padding-bottom: 40px;
    border-top: 1px solid var(--border-default);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .logo { display: flex; }
  img { height: 28px; width: auto; }

  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; }
  .links a,
  .links span { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; color: var(--text-muted); }
  .links a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-strong, var(--ink-300)); }
  .links a:hover { color: var(--text-strong); }
</style>
