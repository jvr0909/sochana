---
// DS TraceSteps, vertical, all steps complete:
// hollow ring at the start, ink nodes at each hop, a teal node where the money lands.
interface Props {
  steps: { label: string; title: string }[];
}

const { steps } = Astro.props;
---

<ol class="trace">
  {
    steps.map((s) => (
      <li>
        <div class="rail">
          <span class="node" />
          <span class="line" />
        </div>
        <div class="text">
          <div class="label">{s.label}</div>
          <div class="title">{s.title}</div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .trace { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  li { display: flex; gap: 14px; min-width: 0; }

  .rail { display: flex; flex-direction: column; align-items: center; width: 14px; flex: none; }
  .node { width: 14px; height: 14px; display: flex; align-items: center; justify-content: center; flex: none; }
  .node::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--ink-900); }
  li:first-child .node::before { width: 12px; height: 12px; border: 2px solid var(--ink-900); background: var(--white); }
  li:last-child .node::before { width: 14px; height: 14px; background: var(--teal-500); }
  .line { flex: 1; width: 2px; min-height: 16px; background: var(--ink-900); }
  li:last-child .line { display: none; }

  .text { padding-bottom: 20px; }
  li:last-child .text { padding-bottom: 0; }
  .label { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px; }
  .title { font-size: 15px; font-weight: 600; color: var(--text-strong); }
</style>
