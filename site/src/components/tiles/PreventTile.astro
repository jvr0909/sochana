---
// 02 · Prevent: rows of dispute terms scrolling past the Sochana app icon.
import { marqueeRows, tileCaptions } from "../../content";
import Aurora from "../ui/Aurora.astro";
import Tile from "./Tile.astro";

const { eyebrow, text } = tileCaptions[1];
---

<Tile eyebrow={eyebrow} caption={text}>
  <Aurora
    blobs={[
      { color: "--blue-500", size: 300, x: "-15%", y: "-10%", duration: 15, path: "b" },
      { color: "--teal-500", size: 280, x: "45%", y: "45%", duration: 12 },
      { color: "--blue-300", size: 180, x: "60%", y: "-5%", duration: 17, path: "b" },
      { color: "--teal-800", size: 240, x: "-10%", y: "60%", duration: 14 },
    ]}
  />
  <div class="marquee" aria-hidden="true">
    {
      marqueeRows.map((row, r) => (
        // Each row is repeated 4× so the -50% slide loops seamlessly; alternate rows run backwards.
        <div class:list={["row", { reverse: r % 2 === 1 }]} style={{ "--d": `${28 + r * 6}s` }}>
          {[...row, ...row, ...row, ...row].map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      ))
    }
  </div>
  <div class="icon"><img src="/app-icon.png" alt="Sochana" width="120" height="120" /></div>
</Tile>

<style>
  .marquee { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
  .row { display: flex; gap: 10px; width: max-content; animation: sx-marquee var(--d) linear infinite; }
  .row.reverse { animation-direction: reverse; }
  .row span {
    flex: none;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    color: var(--ink-900);
    font-size: 15px;
    font-weight: 500;
  }

  .icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: var(--shadow-3);
  }
  .icon img { width: 100%; height: 100%; }
</style>
