---
// 01 · Assess: a sample breakdown of dispute losses by type.
import { diagnostic, tileCaptions } from "../../content";
import Aurora from "../ui/Aurora.astro";
import Tile from "./Tile.astro";

const { eyebrow, text } = tileCaptions[0];
---

<Tile eyebrow={eyebrow} caption={text}>
  <Aurora
    blobs={[
      { color: "--teal-400", size: 300, x: "-20%", y: "40%", duration: 13 },
      { color: "--amber-300", size: 200, x: "50%", y: "65%", duration: 16, path: "b" },
      { color: "--teal-700", size: 260, x: "40%", y: "-10%", duration: 18 },
    ]}
  />
  <div
    class="diag"
    role="img"
    aria-label={`Example dispute diagnostic: ${diagnostic.lead.label} accounts for ${diagnostic.lead.value} of dispute losses`}
  >
    <span class="title">{diagnostic.title}</span>
    <span class="figure">{diagnostic.lead.value}<small>{diagnostic.lead.label}</small></span>
    {
      diagnostic.rows.map((r) => (
        <div class="row">
          <div class="row-head">
            <span>{r.label}</span>
            <span class="amount">{r.value}</span>
          </div>
          <div class="track">
            <span class:list={{ lead: r.lead }} style={{ "--w": `${r.pct}%` }} />
          </div>
        </div>
      ))
    }
  </div>
</Tile>

<style>
  .diag {
    position: absolute;
    left: 36px;
    right: -24px; /* runs off the tile edge on purpose */
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    background: var(--ink-900);
    border: 1px solid var(--ink-700);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-3);
  }
  .title { font-size: 15px; font-weight: 600; color: var(--white); }
  .figure { font-family: var(--font-mono); font-size: 30px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; color: var(--white); }
  .figure small { font-size: 13px; color: var(--ink-300); margin-left: 8px; letter-spacing: 0; }

  .row { display: flex; flex-direction: column; gap: 5px; }
  .row-head { display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-200); }
  .amount { font-family: var(--font-mono); }
  .track { height: 6px; background: var(--ink-800); border-radius: 2px; }
  .track span { display: block; height: 6px; border-radius: 2px; width: var(--w); background: var(--ink-300); }
  .track span.lead { background: var(--teal-500); }
</style>
